# Lombok project-level configuration.
# Ensures JDT (VS Code Java extension) and javac both respect these settings.

# Suppress the "field can be final" suggestion on @Data / @Getter/@Setter classes
# because Lombok generates setters that mutate the field; marking it final would
# break those setters.
lombok.fieldDefaults.defaultFinal=false

# Suppress "variable is never read" lint (fields are accessed via Lombok getters)
# in annotation-processor-aware IDEs.
lombok.addSuppressWarnings=true

config.stopBubbling=true
